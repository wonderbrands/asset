<odoo>
    <record id="view_sr_profile_list" model="ir.ui.view"><field name="name">sr.asset.profile.list</field><field name="model">sr.asset.profile</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="active"/></list></field></record>
    <record id="view_sr_profile_form" model="ir.ui.view"><field name="name">sr.asset.profile.form</field><field name="model">sr.asset.profile</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="active"/></group><field name="attribute_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="value_type"/><field name="uom_id"/><field name="required_for_verification"/><field name="show_on_responsiva"/><field name="highlighted"/></list></field></sheet></form></field></record>
    <record id="action_sr_profiles" model="ir.actions.act_window"><field name="name">Perfiles técnicos</field><field name="res_model">sr.asset.profile</field><field name="view_mode">list,form</field></record>

    <record id="view_sr_attribute_list" model="ir.ui.view"><field name="name">sr.asset.attribute.list</field><field name="model">sr.asset.attribute</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="profile_id"/><field name="value_type"/><field name="uom_id"/><field name="required_for_verification"/><field name="active"/></list></field></record>
    <record id="view_sr_attribute_form" model="ir.ui.view"><field name="name">sr.asset.attribute.form</field><field name="model">sr.asset.attribute</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="profile_id"/><field name="value_type"/><field name="uom_id"/></group><group><field name="required_for_verification"/><field name="show_on_responsiva"/><field name="highlighted"/><field name="active"/></group></group><field name="option_ids" invisible="value_type != 'selection'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="active"/></list></field></sheet></form></field></record>
    <record id="action_sr_attributes" model="ir.actions.act_window"><field name="name">Atributos técnicos</field><field name="res_model">sr.asset.attribute</field><field name="view_mode">list,form</field></record>
    <!-- Opciones de atributos técnicos -->
<record id="view_sr_attribute_option_list" model="ir.ui.view">
    <field name="name">sr.asset.attribute.option.list</field>
    <field name="model">sr.asset.attribute.option</field>
    <field name="arch" type="xml">
        <list>
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="attribute_id"/>
            <field name="active"/>
        </list>
    </field>
</record>

<record id="view_sr_attribute_option_form" model="ir.ui.view">
    <field name="name">sr.asset.attribute.option.form</field>
    <field name="model">sr.asset.attribute.option</field>
    <field name="arch" type="xml">
        <form string="Opción de atributo">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="attribute_id"/>
                    <field name="sequence"/>
                    <field name="active"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="action_sr_attribute_options" model="ir.actions.act_window">
    <field name="name">Opciones de atributos</field>
    <field name="res_model">sr.asset.attribute.option</field>
    <field name="view_mode">list,form</field>
</record>

