    <record id="view_sr_uom_list" model="ir.ui.view"><field name="name">sr.asset.uom.list</field><field name="model">sr.asset.uom</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="symbol"/><field name="active"/></list></field></record>
