<odoo>
    <record id="module_category_sr_it_assets" model="ir.module.category">
        <field name="name">Activos TI</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_sr_it_asset_viewer" model="res.groups">
        <field name="name">Consulta Activos TI</field>
        <field name="category_id" ref="module_category_sr_it_assets"/>
    </record>
    <record id="group_sr_it_asset_user" model="res.groups">
        <field name="name">Gestor Activos TI</field>
        <field name="category_id" ref="module_category_sr_it_assets"/>
        <field name="implied_ids" eval="[(4, ref('group_sr_it_asset_viewer'))]"/>
    </record>
    <record id="group_sr_it_asset_manager" model="res.groups">
        <field name="name">Administrador Activos TI</field>
        <field name="category_id" ref="module_category_sr_it_assets"/>
        <field name="implied_ids" eval="[(4, ref('group_sr_it_asset_user')), (4, ref('maintenance.group_equipment_manager'))]"/>
    </record>
</odoo>
